{
  "name": "council-room-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Council Room desktop companion for Windows",
  "main": "desktop/main.cjs",
  "author": "Council Room",
  "license": "UNLICENSED",
  "scripts": {
    "desktop": "electron .",
    "desktop:dir": "electron-builder --win --x64 --dir --publish never",
    "desktop:installer": "electron-builder --win nsis --x64 --publish never",
    "check": "node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check desktop/opencode-runner.cjs && node --check desktop/concat-mcp.cjs && node --check desktop/motion-studio-agent.cjs && node --check desktop/council-runtime.cjs && node --check app.js && node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.1"
  },
  "build": {
    "appId": "com.councilroom.desktop",
    "productName": "Council Room",
    "asar": true,
    "files": [
      "index.html",
      "styles.css",
      "desktop-companion.css",
      "desktop-companion.js",
      "app.js",
      "manus-routes.json",
      "public/**/*",
      "config/**/*",
      "docs/**/*",
      "prompts/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Council-Room-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "11.0.1"
    },
    "@electron/universal": {
      "minimatch": "11.0.1"
    }
  }
}
