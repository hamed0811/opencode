{
  "name": "council-room-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Council Room desktop companion for Windows",
  "main": "desktop/main.cjs",
  "author": "Council Room",
  "license": "UNLICENSED",
  "scripts": {
    "desktop": "electron .",
    "desktop:dir": "electron-builder --win --x64 --dir",
    "desktop:installer": "electron-builder --win nsis --x64",
    "check": "node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check desktop/opencode-runner.cjs && node --check desktop/concat-mcp.cjs && node --check desktop/council-runtime.cjs && node --check app.js && node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.councilroom.desktop",
    "productName": "Council Room",
    "asar": true,
    "files": [
      "index.html",
      "styles.css",
      "desktop-companion.css",
      "desktop-companion.js",
      "app.js",
      "manus-routes.json",
      "public/**/*",
      "config/**/*",
      "docs/**/*",
      "prompts/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Council-Room-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
