{
  "version": 1,
  "project": {
    "name": "opencode",
    "owner": "hamed0811",
    "defaultBranch": "main",
    "workspace": "./workspace"
  },
  "llm": {
    "provider": "opencode-local",
    "model": null,
    "modelSelection": "opencode-catalog",
    "freeModelsOnly": true,
    "command": "opencode",
    "runArgs": [
      "run"
    ],
    "apiKey": null,
    "temperature": 0.2,
    "structuredOutputs": true,
    "maxOutputTokens": 5000
  },
  "apiGateways": {
    "default": "opencode-local",
    "profiles": [
      {
        "id": "opencode-local",
        "name": "OpenCode محلی",
        "type": "local-cli",
        "category": "Default Agent Runtime",
        "command": "opencode",
        "runArgs": [
          "run"
        ],
        "modelSource": "OpenCode /models catalog",
        "freeModelsOnly": true,
        "enabled": true,
        "badge": "Default / Local",
        "notes": "مسیر پیش‌فرض پاسخ‌گویی؛ مدل از کاتالوگ خود OpenCode انتخاب می‌شود و کلید جداگانه در Council Room نمی‌خواهد",
        "officialSource": "https://opencode.ai/docs/cli/"
      },
      {
        "id": "openrouter",
        "name": "OpenRouter",
        "type": "openai-compatible",
        "category": "Router",
        "baseUrl": "https://openrouter.ai/api/v1",
        "model": "openai/gpt-4o-mini",
        "apiKeyEnv": "OPENROUTER_API_KEY",
        "enabled": false,
        "badge": "Cloud Router",
        "headers": {
          "HTTP-Referer": "${COUNCIL_APP_URL}",
          "X-OpenRouter-Title": "Council Room"
        },
        "notes": "روتر ابری با انتخاب مدل و fallback بین providerها",
        "officialSource": "https://openrouter.ai/docs/api-reference/overview",
        "requiresUserKey": true
      },
      {
        "id": "omniroute",
        "name": "OmniRoute",
        "type": "openai-compatible",
        "category": "Router",
        "baseUrl": "http://localhost:20128/v1",
        "model": "auto",
        "apiKeyEnv": "OMNIROUTE_API_KEY",
        "enabled": false,
        "badge": "Local Router",
        "headers": {},
        "notes": "روتر محلی با endpoint سازگار با OpenAI و مدل auto",
        "officialSource": "https://omniroute.online/api/",
        "requiresUserKey": true
      },
      {
        "id": "openai",
        "name": "OpenAI",
        "type": "openai-compatible",
        "category": "Model Provider",
        "baseUrl": "https://api.openai.com/v1",
        "model": "gpt-4.1-mini",
        "apiKeyEnv": "OPENAI_API_KEY",
        "enabled": false,
        "badge": "Native API",
        "headers": {},
        "notes": "API رسمی OpenAI با Bearer authentication",
        "officialSource": "https://platform.openai.com/docs/api-reference/introduction",
        "requiresUserKey": true
      },
      {
        "id": "anthropic",
        "name": "Anthropic",
        "type": "openai-compatible",
        "category": "Model Provider",
        "baseUrl": "https://api.anthropic.com/v1/",
        "model": "claude-opus-5-5",
        "apiKeyEnv": "ANTHROPIC_API_KEY",
        "enabled": false,
        "badge": "Claude API",
        "headers": {
          "anthropic-version": "2023-06-01"
        },
        "notes": "برای قابلیت‌های کامل Claude از Messages API native استفاده شود؛ این profile برای compatibility است",
        "officialSource": "https://docs.anthropic.com/en/api/openai-sdk",
        "requiresUserKey": true
      },
      {
        "id": "google-gemini",
        "name": "Google Gemini",
        "type": "openai-compatible",
        "category": "Model Provider",
        "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
        "model": "gemini-4-hydrogen",
        "apiKeyEnv": "GEMINI_API_KEY",
        "enabled": false,
        "badge": "Gemini API",
        "headers": {},
        "notes": "endpoint رسمی OpenAI-compatible گوگل",
        "officialSource": "https://ai.google.dev/gemini-api/docs/openai",
        "requiresUserKey": true
      },
      {
        "id": "mistral-ai",
        "name": "Mistral AI",
        "type": "openai-compatible",
        "category": "Model Provider",
        "baseUrl": "https://api.mistral.ai/openai/v1",
        "model": "mistral-small-latest",
        "apiKeyEnv": "MISTRAL_API_KEY",
        "enabled": false,
        "badge": "Mistral API",
        "headers": {},
        "notes": "Chat Completions سازگار با OpenAI",
        "officialSource": "https://docs.mistral.ai/inference/conversations/chat-completion",
        "requiresUserKey": true
      },
      {
        "id": "groq",
        "name": "Groq",
        "type": "openai-compatible",
        "category": "Fast Inference",
        "baseUrl": "https://api.groq.com/openai/v1",
        "model": "llama-3.3-70b-versatile",
        "apiKeyEnv": "GROQ_API_KEY",
        "enabled": false,
        "badge": "Fast Inference",
        "headers": {},
        "notes": "inference سریع با API سازگار با OpenAI",
        "officialSource": "https://console.groq.com/docs/openai",
        "requiresUserKey": true
      },
      {
        "id": "deepseek",
        "name": "DeepSeek",
        "type": "openai-compatible",
        "category": "Model Provider",
        "baseUrl": "https://api.deepseek.com",
        "model": "deepseek-flash",
        "apiKeyEnv": "DEEPSEEK_API_KEY",
        "enabled": false,
        "badge": "DeepSeek API",
        "headers": {},
        "notes": "OpenAI-compatible با Bearer authentication",
        "officialSource": "https://api-docs.deepseek.com/quick_start/",
        "requiresUserKey": true
      },
      {
        "id": "xai",
        "name": "xAI",
        "type": "openai-compatible",
        "category": "Model Provider",
        "baseUrl": "https://api.x.ai/v1",
        "model": "grok-4.7",
        "apiKeyEnv": "XAI_API_KEY",
        "enabled": false,
        "badge": "Grok API",
        "headers": {},
        "notes": "REST API سازگار با OpenAI برای مدل‌های Grok",
        "officialSource": "https://docs.x.ai/developers/rest-api-reference/inference",
        "requiresUserKey": true
      },
      {
        "id": "cohere",
        "name": "Cohere",
        "type": "openai-compatible",
        "category": "Enterprise AI",
        "baseUrl": "https://api.cohere.com/compatibility",
        "model": "command-a-03-2025",
        "apiKeyEnv": "COHERE_API_KEY",
        "enabled": false,
        "badge": "Compatibility API",
        "headers": {},
        "notes": "لایه compatibility رسمی Cohere برای OpenAI SDK",
        "officialSource": "https://docs.cohere.com/docs/compatibility-api",
        "requiresUserKey": true
      },
      {
        "id": "together-ai",
        "name": "Together AI",
        "type": "openai-compatible",
        "category": "Inference Platform",
        "baseUrl": "https://api.together.ai/v1",
        "model": "<provider>/<model_name>",
        "apiKeyEnv": "TOGETHER_API_KEY",
        "enabled": false,
        "badge": "Open Models",
        "headers": {},
        "notes": "مدل‌ها با شناسه provider/model انتخاب می‌شوند",
        "officialSource": "https://docs.together.ai/docs/inference/openai-compatibility",
        "requiresUserKey": true
      },
      {
        "id": "fireworks-ai",
        "name": "Fireworks AI",
        "type": "openai-compatible",
        "category": "Inference Platform",
        "baseUrl": "https://api.fireworks.ai/inference/v1",
        "model": "accounts/fireworks/models/glm-5p3-flash",
        "apiKeyEnv": "FIREWORKS_API_KEY",
        "enabled": false,
        "badge": "Serverless Inference",
        "headers": {},
        "notes": "endpoint OpenAI-compatible برای inference مدل‌ها",
        "officialSource": "https://docs.fireworks.ai/getting-started/quickstart",
        "requiresUserKey": true
      },
      {
        "id": "perplexity",
        "name": "Perplexity",
        "type": "openai-compatible",
        "category": "Search AI",
        "baseUrl": "https://api.perplexity.ai/v1",
        "model": "openai/gpt-5.6-sol",
        "apiKeyEnv": "PERPLEXITY_API_KEY",
        "enabled": false,
        "badge": "Agent API",
        "headers": {},
        "notes": "Responses API سازگار با OpenAI و مدل‌های جست‌وجومحور",
        "officialSource": "https://docs.perplexity.ai/docs/agent-api/openai-compatibility",
        "requiresUserKey": true
      },
      {
        "id": "cerebras",
        "name": "Cerebras",
        "type": "openai-compatible",
        "category": "Fast Inference",
        "baseUrl": "https://api.cerebras.ai/v1",
        "model": "gpt-oss-120b",
        "apiKeyEnv": "CEREBRAS_API_KEY",
        "enabled": false,
        "badge": "Fast Inference",
        "headers": {},
        "notes": "inference سریع با API سازگار با OpenAI",
        "officialSource": "https://inference-docs.cerebras.ai/resources/openai",
        "requiresUserKey": true
      },
      {
        "id": "sambanova",
        "name": "SambaNova",
        "type": "openai-compatible",
        "category": "Inference Platform",
        "baseUrl": "https://api.sambanova.ai/v1",
        "model": "Meta-Llama-3.3-70B-Instruct",
        "apiKeyEnv": "SAMBANOVA_API_KEY",
        "enabled": false,
        "badge": "Enterprise Inference",
        "headers": {},
        "notes": "Chat Completions و Responses سازگار با OpenAI",
        "officialSource": "https://docs.sambanova.ai/docs/en/features/openai-compatibility",
        "requiresUserKey": true
      },
      {
        "id": "huggingface-inference",
        "name": "Hugging Face Inference",
        "type": "openai-compatible",
        "category": "Model Hub",
        "baseUrl": "https://router.huggingface.co/v1",
        "model": "openai/gpt-oss-120b",
        "apiKeyEnv": "HF_TOKEN",
        "enabled": false,
        "badge": "Inference Providers",
        "headers": {},
        "notes": "نیازمند User Access Token با مجوز Inference Providers",
        "officialSource": "https://huggingface.co/docs/inference-providers/guides/gpt-oss",
        "requiresUserKey": true
      },
      {
        "id": "replicate",
        "name": "Replicate",
        "type": "native-rest",
        "category": "Model Platform",
        "baseUrl": "https://api.replicate.com/v1",
        "model": "black-forest-labs/flux-1.1-pro",
        "apiKeyEnv": "REPLICATE_API_TOKEN",
        "enabled": false,
        "badge": "Native REST",
        "headers": {},
        "notes": "native REST API با Bearer token؛ OpenAI-compatible نیست",
        "officialSource": "https://replicate.com/docs/reference/http",
        "requiresUserKey": true
      },
      {
        "id": "nvidia-nim",
        "name": "NVIDIA NIM",
        "type": "openai-compatible",
        "category": "Inference Platform",
        "baseUrl": "https://integrate.api.nvidia.com/v1",
        "model": "nvidia/nemotron-3.5-lightning-30b-a3b",
        "apiKeyEnv": "NVIDIA_API_KEY",
        "enabled": false,
        "badge": "NVIDIA API Catalog",
        "headers": {},
        "notes": "NVIDIA API Catalog با endpoint سازگار با OpenAI",
        "officialSource": "https://docs.nvidia.com/nim/large-language-models/reference/api-reference",
        "requiresUserKey": true
      }
    ]
  },
  "optionalProviders": {
    "enabledByDefault": false,
    "requiresUserOptIn": true,
    "secretStorage": "server_secret_or_windows_credential_manager",
    "allowedSecretEnv": [
      "OPENAI_API_KEY",
      "ANTHROPIC_API_KEY",
      "GEMINI_API_KEY",
      "MISTRAL_API_KEY",
      "GROQ_API_KEY",
      "DEEPSEEK_API_KEY",
      "XAI_API_KEY",
      "COHERE_API_KEY",
      "OPENROUTER_API_KEY",
      "OMNIROUTE_API_KEY"
    ],
    "neverExposeIn": [
      "browser",
      "prompt",
      "transcript",
      "diff",
      "git",
      "pull_request"
    ]
  },
  "orchestrator": {
    "id": "chief-engineer",
    "displayName": "پرشین",
    "role": "مدیر ارشد و مغز متفکر سیستم",
    "maxTurnsPerMeeting": 12,
    "parallelConsultations": true,
    "requireEvidenceForClaims": true,
    "alwaysInviteDissent": true,
    "humanApprovalFor": [
      "production_deploy",
      "merge_pull_request",
      "database_destructive_migration",
      "secret_or_permission_change"
    ]
  },
  "council": {
    "moderator": "orchestrator",
    "judge": "final-judge",
    "dissentAgent": "critic",
    "agents": [
      "requirements",
      "architect",
      "backend",
      "frontend",
      "database",
      "security",
      "qa",
      "devops",
      "critic"
    ],
    "decisionWeights": {
      "technicalCorrectness": 0.25,
      "security": 0.25,
      "maintainability": 0.15,
      "testability": 0.15,
      "deliverySpeed": 0.1,
      "cost": 0.1
    },
    "vetoRules": [
      "critical_security_risk",
      "missing_rollback_for_irreversible_change",
      "unbounded_tool_execution"
    ]
  },
  "github": {
    "repository": "hamed0811/opencode",
    "defaultBranch": "main",
    "pullRequests": {
      "enabled": true,
      "draftByDefault": true,
      "branchPrefix": "agent/",
      "requireGreenChecks": true,
      "requireHumanApprovalToMerge": true,
      "neverPushDirectlyTo": [
        "main"
      ]
    },
    "allowedOperations": [
      "read",
      "branch",
      "commit",
      "push_feature_branch",
      "create_pull_request"
    ]
  },
  "execution": {
    "sandbox": {
      "enabled": true,
      "network": "deny_by_default",
      "timeoutSeconds": 900,
      "maxFilesChangedPerRun": 80
    },
    "allowedTools": [
      "read_file",
      "write_file",
      "edit_file",
      "run_tests",
      "git_diff",
      "git_commit",
      "git_push_feature_branch",
      "github_create_pull_request"
    ],
    "blockedTools": [
      "delete_repository",
      "force_push",
      "merge_pull_request",
      "read_secrets",
      "production_deploy"
    ]
  },
  "observability": {
    "eventStore": "./runtime/events.jsonl",
    "persistFullTranscript": true,
    "redactSecrets": true,
    "dashboard": {
      "showAgentThinking": false,
      "showMessages": true,
      "showToolCalls": true,
      "showDiffs": true,
      "showApprovals": true
    }
  }
}
